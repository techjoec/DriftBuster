<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>driftbuster</AssemblyName>
    <RootNamespace>DriftBuster.Cli</RootNamespace>
    <Version>$(DriftBusterCoreVersion)</Version>
    <AssemblyVersion>$(DriftBusterCoreVersion)</AssemblyVersion>
    <FileVersion>$(DriftBusterCoreVersion)</FileVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- A publish for a runtime identifier (dotnet publish -c Release -r win-x64|linux-x64) ships the .NET runtime in the folder so nothing has to be installed on the target. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DriftBuster.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\gui\DriftBuster.Backend\DriftBuster.Backend.csproj" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>
</Project>
