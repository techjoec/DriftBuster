root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true

[*.axaml]
indent_size = 2

[*.{csproj,props,targets}]
indent_size = 2

[**/obj/**]
generated_code = true

[*.g.cs]
generated_code = true
