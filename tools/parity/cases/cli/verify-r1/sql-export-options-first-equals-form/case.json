{
 "python": [
  "-m",
  "driftbuster.cli",
  "export-sql",
  "--mask-column",
  "accounts.secret",
  "--output-dir=out",
  "demo.sqlite",
  "--hash-column=accounts.email",
  "--hash-salt",
  "s"
 ],
 "port": [
  "sql-export",
  "--mask-column",
  "accounts.secret",
  "--output-dir=out",
  "demo.sqlite",
  "--hash-column=accounts.email",
  "--hash-salt",
  "s"
 ],
 "compare_stderr": true,
 "databases": {
  "demo.sqlite": "CREATE TABLE accounts (id INTEGER PRIMARY KEY, email TEXT, secret TEXT);INSERT INTO accounts (email, secret) VALUES ('alice@example.com', 'token');"
 },
 "accept": [
  "run-clock"
 ]
}
