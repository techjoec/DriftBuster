<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="Primary" connectionString="Server=db;Database=main" />
    <add name="Primary" connectionString="Server=db;Database=main" />
    <add name="Audit" connectionString=" Server=audit;Database=log " />
  </connectionStrings>
  <system.serviceModel>
    <client>
      <endpoint name="Billing" address="https://billing.internal/soap" binding="basicHttpBinding" />
      <endpoint name="Share" address="\\fileserver\share" />
      <endpoint name="Local" address="localhost" />
    </client>
  </system.serviceModel>
  <appSettings>
    <add key="Api.BaseAddress" value="https://api.internal/" />
    <add key="Feature.Beta" value="true" />
    <add key="FlagNoValue" />
    <featureToggle name="Dark" enabled="false" />
    <featureToggle id="Fast" isEnabled="yes" />
    <toggle key="Legacy" defaultValue="off" />
  </appSettings>
</configuration>
