{
 "name": "empties",
 "sources": [
  {
   "path": "empty",
   "optional": true,
   "exclude": [
    ".keep"
   ]
  },
  {
   "path": "full",
   "optional": true,
   "exclude": "*"
  },
  {
   "path": "full/*.nope",
   "optional": true,
   "alias": "none"
  },
  {
   "path": "full/a.log",
   "exclude": [
    "a.log"
   ]
  }
 ]
}