{
  "name": "ruleset",
  "sources": [
    {
      "path": "conf",
      "alias": "conf"
    }
  ],
  "secret_scanner": {
    "ruleset": {
      "version": "custom-1",
      "rules": [
        {
          "name": "Token",
          "pattern": "TOK[0-9]+"
        },
        {
          "name": "bad",
          "pattern": "("
        }
      ]
    },
    "ignore_patterns": " ALLOW ;, DENY ",
    "ignore_rules": [
      "bad",
      null,
      3
    ]
  }
}
