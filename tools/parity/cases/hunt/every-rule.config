<?xml version="1.0"?>
<configuration>
  <!-- server host settings -->
  <add key="ServerHost" value="app01.corp.local" />
  <add key="Certificate" thumbprint="0123456789abcdef0123456789abcdef01234567" />
  <add key="CertificateSha256" value="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" />
  <add key="Version" value="4.12.7.1" />
  <add key="InstallPath" value="/opt/vendor-app.v2/bin" />
  <add name="Main" connectionString="Server=sql.corp.local;Database=App;" />
  <client><endpoint address="net.tcp://svc.example.local:9000/Feed" binding="netTcp" /></client>
  <add key="ServiceUrl" value="https://api.example.com/v1/" />
  <add baseAddress="http://base.example.net/" endpoint="https://ep.example.com" />
  <add key="FeatureFlag:NewDashboard" value="true" />
  <feature name="beta" enabled="false" />
</configuration>
