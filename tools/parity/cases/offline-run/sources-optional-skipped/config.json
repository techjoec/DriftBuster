{
  "profile": {
    "name": "optional",
    "sources": [
      "present.txt",
      {
        "path": "missing.txt",
        "optional": true
      },
      {
        "path": "nothing/*.cfg",
        "optional": true,
        "exclude": [
          "*.bak"
        ]
      },
      {
        "path": "missing-dir",
        "optional": "yes",
        "alias": "  "
      },
      {
        "sql_snapshot": {
          "path": "missing.sqlite"
        },
        "optional": true
      }
    ]
  },
  "runner": {
    "output_directory": "out",
    "cleanup_staging": false
  }
}
