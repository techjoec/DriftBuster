{
  "profile": {
    "name": "sets",
    "sources": [
      {
        "path": "logs/x[-_]?.log",
        "alias": "set"
      },
      {
        "path": "logs/[!x]*.log",
        "alias": "negated"
      },
      {
        "path": "logs/*.LOG",
        "alias": "upper"
      },
      {
        "path": "logs/a[b].txt",
        "alias": "bracket-literal",
        "optional": true
      },
      {
        "path": "logs/*",
        "alias": "star-skips-hidden"
      },
      "logs/café ☃.txt"
    ]
  },
  "runner": {
    "output_directory": "out",
    "cleanup_staging": false,
    "compress": false
  }
}
