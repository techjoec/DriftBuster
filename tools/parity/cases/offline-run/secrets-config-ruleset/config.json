{
  "profile": {
    "name": "config-rules",
    "sources": [
      "inputs"
    ],
    "secret_scanner": {
      "ruleset": {
        "version": "custom-7",
        "rules": [
          {
            "name": "Token",
            "pattern": "tok=[A-Za-z0-9]+"
          },
          {
            "name": "Pin",
            "pattern": "pin:[0-9]{4}"
          },
          {
            "name": "Caseless",
            "pattern": "secret-[a-z]+",
            "flags": "i"
          },
          {
            "name": "Broken",
            "pattern": "(unclosed"
          },
          {
            "name": "",
            "pattern": "nameless"
          },
          {
            "name": "Skipped",
            "pattern": "skip"
          }
        ]
      },
      "ignore_rules": [
        "Skipped"
      ],
      "ignore_patterns": [
        "IGNORE ME",
        "IGNORE ME"
      ]
    }
  },
  "runner": {
    "output_directory": "out",
    "cleanup_staging": false
  }
}
