{
  "profile": {
    "name": "sql-mask",
    "sources": [
      {
        "sql_snapshot": {
          "path": "db/data.sqlite",
          "mask_columns": [
            "accounts.secret",
            "accounts.missing",
            "bad",
            ".x"
          ],
          "hash_columns": {
            "accounts": [
              "email",
              "raw",
              "balance",
              "note",
              "id"
            ],
            "": [
              "x"
            ]
          },
          "hash_salt": "pepper",
          "placeholder": "<masked>"
        },
        "alias": " db "
      }
    ]
  },
  "runner": {
    "output_directory": "out",
    "cleanup_staging": false
  }
}
