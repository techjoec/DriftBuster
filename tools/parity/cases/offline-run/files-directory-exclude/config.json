{
  "profile": {
    "name": "dir-exclude",
    "tags": [
      "a",
      "b"
    ],
    "description": "Directory with excludes",
    "sources": [
      {
        "path": "app",
        "alias": "Application Files",
        "exclude": [
          "*.tmp",
          "backup/*.bak",
          "sub/deep/*",
          ".hidden/*"
        ]
      }
    ]
  },
  "runner": {
    "output_directory": "out",
    "cleanup_staging": false
  }
}
