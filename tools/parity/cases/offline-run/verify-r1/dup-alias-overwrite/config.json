{
  "profile": {
    "name": "dup",
    "sources": [
      {
        "path": "one",
        "alias": "same"
      },
      {
        "path": "two",
        "alias": "same"
      },
      {
        "path": "one/a.txt",
        "alias": "same"
      },
      {
        "path": "o*",
        "alias": "glob-dir-and-file"
      },
      "one/*",
      "one/../one/a.txt"
    ]
  },
  "runner": {
    "output_directory": "out",
    "cleanup_staging": false,
    "compress": false,
    "max_total_bytes": 36
  }
}
