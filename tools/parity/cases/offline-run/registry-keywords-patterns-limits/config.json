{
  "profile": {
    "name": "registry-search",
    "sources": [
      {
        "registry_scan": {
          "token": "Parity",
          "roots": [
            "HKCU\\Software\\DriftBusterOfflineRunParity\\keywords"
          ],
          "keywords": [
            "secret"
          ],
          "max_depth": 0
        },
        "alias": "depth0"
      },
      {
        "registry_scan": {
          "token": "Parity",
          "roots": [
            "HKCU\\Software\\DriftBusterOfflineRunParity\\keywords"
          ],
          "keywords": "SECRET deep"
        },
        "alias": "keywords"
      },
      {
        "registry_scan": {
          "token": "Parity",
          "roots": [
            "HKCU\\Software\\DriftBusterOfflineRunParity\\keywords"
          ],
          "patterns": [
            "^\\d+$",
            "EXP"
          ],
          "max_hits": "2"
        },
        "alias": "patterns"
      },
      {
        "registry_scan": {
          "token": "Parity",
          "roots": [
            "HKCU\\Software\\DriftBusterOfflineRunParity\\keywords"
          ],
          "max_hits": 3
        },
        "alias": "hits3"
      }
    ]
  },
  "runner": {
    "output_directory": "out",
    "cleanup_staging": false,
    "compress": false
  }
}
