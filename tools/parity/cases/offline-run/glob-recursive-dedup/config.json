{
  "profile": {
    "name": "recursive",
    "sources": [
      {
        "path": "app/**/*.txt",
        "alias": "texts"
      },
      {
        "path": "app/**",
        "alias": "starstar"
      },
      {
        "path": "app/*/",
        "alias": "dirs-only"
      },
      {
        "path": "app/sub/../notes.txt",
        "alias": "dotdot"
      }
    ]
  },
  "runner": {
    "output_directory": "out",
    "cleanup_staging": false
  }
}
