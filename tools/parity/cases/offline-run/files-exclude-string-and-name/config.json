{
  "profile": {
    "name": "exclude-string",
    "sources": [
      {
        "path": "app",
        "exclude": "*.json"
      },
      {
        "path": "app/*.config",
        "alias": "configs",
        "exclude": [
          "app.config"
        ],
        "optional": true
      },
      {
        "path": "app/cache",
        "alias": "cache",
        "exclude": [
          "[!k]*"
        ]
      }
    ]
  },
  "runner": {
    "output_directory": "out",
    "cleanup_staging": false,
    "compress": false
  }
}
