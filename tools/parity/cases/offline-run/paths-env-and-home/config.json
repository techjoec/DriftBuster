{
  "profile": {
    "name": "env",
    "sources": [
      {
        "path": "$DB_OFFLINE_DATA/a.txt",
        "alias": "dollar"
      },
      {
        "path": "${DB_OFFLINE_DATA}/a.txt",
        "alias": "braces"
      },
      {
        "path": "%DB_OFFLINE_DATA%/a.txt",
        "alias": "percent",
        "optional": true
      },
      {
        "path": "$DB_OFFLINE_UNSET/a.txt",
        "alias": "unset",
        "optional": true
      },
      {
        "path": "~/home.txt",
        "alias": "tilde"
      },
      {
        "path": "{run}{sep}abs.txt",
        "alias": "absolute"
      }
    ]
  },
  "runner": {
    "output_directory": "$DB_OFFLINE_OUT/nested",
    "cleanup_staging": false,
    "compress": "false"
  }
}
