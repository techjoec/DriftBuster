{
  "profile": {
    "name": "ignore-options",
    "sources": [
      "inputs/app.env"
    ],
    "options": {
      "secret_ignore_rules": "AwsAccessKeyId, GenericApiToken",
      "secret_ignore_patterns": [
        "^#.*"
      ]
    },
    "secret_scanner": {
      "ignore_rules": "PasswordAssignment;AwsAccessKeyId",
      "ignore_patterns": "tail$ ^#.*"
    }
  },
  "runner": {
    "output_directory": "out",
    "cleanup_staging": false
  }
}
