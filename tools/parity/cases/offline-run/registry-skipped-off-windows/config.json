{
  "profile": {
    "name": "registry-linux",
    "sources": [
      {
        "registry_scan": {
          "token": "Contoso App",
          "keywords": "server, port;timeout",
          "patterns": [
            "^\\d+$"
          ],
          "max_depth": "3"
        }
      },
      {
        "registry_scan": {
          "token": "Other",
          "roots": [
            "HKLM\\Software\\Other"
          ]
        },
        "alias": "other"
      },
      "a.txt"
    ]
  },
  "runner": {
    "output_directory": "out",
    "cleanup_staging": false
  }
}
