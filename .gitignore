# ── Artifacts (deny-all, then allowlist curated evidence only) ───
#
# Everything under artifacts/ is ignored by default.  Only checked-in
# evidence directories are allowlisted below.  Ephemeral outputs
# (logs, coverage, build transcripts, hashes) must NEVER be tracked.
!artifacts/
artifacts/*

# Per-directory allowlists — keep tight, no blanket ** for logs
!artifacts/sql/
!artifacts/sql/**
!artifacts/cli-plan/
!artifacts/cli-plan/**
!artifacts/release/
!artifacts/release/**
!artifacts/manual-runs/
!artifacts/manual-runs/**
!artifacts/encryption/
!artifacts/encryption/**
!artifacts/gui-packaging/
!artifacts/gui-packaging/**
!artifacts/gui-accessibility/
!artifacts/gui-accessibility/**
!artifacts/builds/
!artifacts/builds/**
!artifacts/perf/
!artifacts/perf/**
!artifacts/notifications/
!artifacts/notifications/**
!artifacts/reporting/
!artifacts/reporting/**
!artifacts/formats/
!artifacts/formats/**
!artifacts/samples/
!artifacts/samples/**
!artifacts/diff-planner-validation/
!artifacts/diff-planner-validation/**

# Block ephemeral files even inside allowlisted dirs
artifacts/**/*.log
artifacts/**/*.sha256
artifacts/gui-packaging/*.json
artifacts/builds/**/*.log
