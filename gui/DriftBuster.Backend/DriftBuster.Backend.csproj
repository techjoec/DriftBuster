<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>$(DriftBusterCoreVersion)</Version>
    <AssemblyVersion>$(DriftBusterCoreVersion)</AssemblyVersion>
    <FileVersion>$(DriftBusterCoreVersion)</FileVersion>
    <!-- Infrastructure/UnixFileType.cs: the statx P/Invoke reads its result buffer through a pointer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The PowerShell module loads the backend straight from its build output, which then needs Microsoft.Data.Sqlite and its native runtimes beside it. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DriftBuster.Backend.Tests" />
    <!-- The CLI assembly is named driftbuster. -->
    <InternalsVisibleTo Include="driftbuster" />
    <InternalsVisibleTo Include="DriftBuster.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\secret_rules.json" />
  </ItemGroup>
</Project>
