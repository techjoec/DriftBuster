<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="using:Avalonia.Automation"
        x:Class="DriftBuster.Gui.Views.CredentialWindow"
        Width="440"
        SizeToContent="Height"
        Title="Save sign-in"
        WindowStartupLocation="CenterOwner">
  <StackPanel Spacing="10" Margin="20">
    <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Classes="subtitle" TextWrapping="Wrap"
               Text="Saved as a file only your Windows account on this computer can read (DPAPI). The password is never stored in the session." />
    <TextBox x:Name="UserName" PlaceholderText="User name, e.g. CORP\collector"
             automation:AutomationProperties.AutomationId="Credential.UserName"
             automation:AutomationProperties.Name="User name" />
    <TextBox x:Name="Password" PasswordChar="●" PlaceholderText="Password"
             automation:AutomationProperties.AutomationId="Credential.Password"
             automation:AutomationProperties.Name="Password" />
    <TextBlock x:Name="Error" Foreground="{DynamicResource Brush.Accent}" TextWrapping="Wrap" IsVisible="False" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Classes="outline" Click="OnCancel" automation:AutomationProperties.AutomationId="Credential.Cancel" />
      <Button x:Name="SaveButton" Content="Save" Classes="primary" Click="OnSave" automation:AutomationProperties.AutomationId="Credential.Save" />
    </StackPanel>
  </StackPanel>
</Window>
