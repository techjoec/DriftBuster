<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="using:Avalonia.Automation"
             xmlns:vm="using:DriftBuster.Gui.ViewModels"
             xmlns:conv="using:DriftBuster.Gui.Converters"
             x:Class="DriftBuster.Gui.Views.RunProfilesView"
             x:DataType="vm:RunProfilesViewModel">
  <!-- Fills the space it is given: saved profiles on the left, the selected profile's form on the right. -->
  <Grid RowDefinitions="Auto,*" RowSpacing="10">
    <StackPanel Spacing="2">
      <TextBlock Classes="heading" Text="Profiles" />
      <TextBlock Classes="subtitle" Text="Save the folders and options of a scan you run often, run it again, schedule it, or build an offline collector from it." />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="280,6,*">
    <Border Classes="pane">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Saved profiles" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Refresh" Classes="outline"
                  Command="{Binding RefreshCommand}"
                  automation:AutomationProperties.AutomationId="Profiles.Refresh" />
        </Grid>
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Profiles}"
                 SelectedItem="{Binding SelectedProfile}"
                 Background="Transparent"
                 automation:AutomationProperties.AutomationId="Profiles.List"
                 automation:AutomationProperties.Name="Saved profiles">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" Classes="subtitle" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Row="2" Content="Load" Classes="primary"
                HorizontalAlignment="Left"
                Command="{Binding LoadProfileCommand}"
                CommandParameter="{Binding SelectedProfile}"
                automation:AutomationProperties.AutomationId="Profiles.Load" />
      </Grid>
    </Border>
    <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

    <Border Grid.Column="2" Classes="pane">
      <Grid RowDefinitions="Auto,*" RowSpacing="12">
      <!-- The actions stay in view while the form below scrolls. -->
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Save profile" Classes="primary" Command="{Binding SaveCommand}" automation:AutomationProperties.AutomationId="Profiles.Save" />
          <Button Content="Run profile" Classes="primary" Command="{Binding RunCommand}" automation:AutomationProperties.AutomationId="Profiles.Run" />
          <Button Content="Prepare offline collector" Classes="outline"
                  Click="OnPrepareOfflineCollector"
                  automation:AutomationProperties.AutomationId="Profiles.PrepareOfflineCollector" />
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}" Classes="subtitle" TextWrapping="Wrap" />
      </StackPanel>
      <ScrollViewer Grid.Row="1" AllowAutoHide="False">
        <StackPanel Spacing="18" Margin="0,0,18,0">
          <StackPanel Spacing="6">
            <TextBlock Text="Profile details" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Classes="subtitle" Text="Define paths, baseline, and options for repeatable scans." />
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Text="Name" FontWeight="SemiBold" />
            <TextBox Text="{Binding ProfileName, Mode=TwoWay}" automation:AutomationProperties.AutomationId="Profiles.Name" automation:AutomationProperties.Name="Profile name" />
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Text="Description" FontWeight="SemiBold" />
            <TextBox Text="{Binding ProfileDescription, Mode=TwoWay}" automation:AutomationProperties.AutomationId="Profiles.Description" automation:AutomationProperties.Name="Profile description" />
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Text="Sources" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding Sources}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,10" Padding="12" CornerRadius="{DynamicResource Radius.Medium}" Classes="surface">
                    <StackPanel Spacing="8">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <RadioButton Content="Baseline"
                                     IsChecked="{Binding IsBaseline, Mode=TwoWay}"
                                     GroupName="BaselineGroup"
                                     automation:AutomationProperties.AutomationId="Profiles.Source.Baseline" />
                        <TextBlock Text="Active baseline"
                                   Classes="subtitle"
                                   IsVisible="{Binding IsBaseline}" />
                      </StackPanel>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding Path, Mode=TwoWay}"
                                 automation:AutomationProperties.AutomationId="Profiles.Source.Path"
                                 automation:AutomationProperties.Name="Source path" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                          <Button Content="File"
                                  Tag="{Binding}"
                                  Click="OnBrowseFile"
                                  automation:AutomationProperties.AutomationId="Profiles.Source.BrowseFile" />
                          <Button Content="Folder"
                                  Tag="{Binding}"
                                  Click="OnBrowseFolder"
                                  automation:AutomationProperties.AutomationId="Profiles.Source.BrowseFolder" />
                          <Button Content="Remove"
                                  Command="{Binding ((vm:RunProfilesViewModel)DataContext).RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"
                                  automation:AutomationProperties.AutomationId="Profiles.Source.Remove" />
                        </StackPanel>
                      </Grid>
                      <Grid ColumnDefinitions="*,2*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding Alias, Mode=TwoWay}"
                                 PlaceholderText="Alias (optional)"
                                 automation:AutomationProperties.AutomationId="Profiles.Source.Alias"
                                 automation:AutomationProperties.Name="Source alias" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Exclude, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 MinHeight="32"
                                 PlaceholderText="Exclude patterns (one per line)"
                                 automation:AutomationProperties.AutomationId="Profiles.Source.Exclude"
                                 automation:AutomationProperties.Name="Source exclude patterns" />
                        <CheckBox Grid.Column="2"
                                  Content="Optional"
                                  IsChecked="{Binding Optional, Mode=TwoWay}"
                                  automation:AutomationProperties.AutomationId="Profiles.Source.Optional"
                                  automation:AutomationProperties.Name="Optional source" />
                      </Grid>
                      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Accent}" Classes="subtitle" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Add source" Command="{Binding AddSourceCommand}" HorizontalAlignment="Left" automation:AutomationProperties.AutomationId="Profiles.AddSource" />
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Text="Options" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding Options}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,2*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
                    <TextBox Text="{Binding Key, Mode=TwoWay}" PlaceholderText="Key" automation:AutomationProperties.AutomationId="Profiles.Option.Key" automation:AutomationProperties.Name="Option key" />
                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="Value" automation:AutomationProperties.AutomationId="Profiles.Option.Value" automation:AutomationProperties.Name="Option value" />
                    <Button Grid.Column="2" Content="Remove" Classes="outline"
                            Command="{Binding ((vm:RunProfilesViewModel)DataContext).RemoveOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            automation:AutomationProperties.AutomationId="Profiles.Option.Remove" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Add option" Classes="outline" Command="{Binding AddOptionCommand}" HorizontalAlignment="Left" automation:AutomationProperties.AutomationId="Profiles.AddOption" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Content="Secret scanner settings" Classes="outline"
                      Click="OnSecretScannerSettings"
                      HorizontalAlignment="Left"
                      automation:AutomationProperties.AutomationId="Profiles.SecretScannerSettings" />
              <TextBlock Text="{Binding SecretScannerSummary}" Classes="subtitle" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Text="Schedules" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding Schedules}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,10" Padding="12" CornerRadius="{DynamicResource Radius.Medium}" Classes="surface">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding Name, Mode=TwoWay}"
                                 PlaceholderText="Name"
                                 automation:AutomationProperties.AutomationId="Profiles.Schedule.Name"
                                 automation:AutomationProperties.Name="Schedule name" />
                        <ComboBox Grid.Column="1" IsEditable="True" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding ((vm:RunProfilesViewModel)DataContext).ProfileSuggestions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  SelectedItem="{Binding Profile, Mode=TwoWay}"
                                  Text="{Binding Profile, Mode=TwoWay}"
                                  PlaceholderText="Profile"
                                  automation:AutomationProperties.AutomationId="Profiles.Schedule.Profile"
                                  automation:AutomationProperties.Name="Schedule profile" />
                        <TextBox Grid.Column="2" Text="{Binding Every, Mode=TwoWay}"
                                 PlaceholderText="Interval (e.g. 24h)"
                                 automation:AutomationProperties.AutomationId="Profiles.Schedule.Interval"
                                 automation:AutomationProperties.Name="Schedule interval" />
                        <Button Grid.Column="3" Content="Remove"
                                Classes="outline"
                                Command="{Binding ((vm:RunProfilesViewModel)DataContext).RemoveScheduleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                automation:AutomationProperties.AutomationId="Profiles.Schedule.Remove" />
                      </Grid>
                      <Grid ColumnDefinitions="2*,*,*,*" ColumnSpacing="8">
                        <TextBox Text="{Binding StartAt, Mode=TwoWay}"
                                 PlaceholderText="Start at (UTC, optional)"
                                 automation:AutomationProperties.AutomationId="Profiles.Schedule.StartAt"
                                 automation:AutomationProperties.Name="Schedule start time" />
                        <TextBox Grid.Column="1" Text="{Binding WindowStart, Mode=TwoWay}"
                                 PlaceholderText="Window start"
                                 automation:AutomationProperties.AutomationId="Profiles.Schedule.WindowStart"
                                 automation:AutomationProperties.Name="Window start" />
                        <TextBox Grid.Column="2" Text="{Binding WindowEnd, Mode=TwoWay}"
                                 PlaceholderText="Window end"
                                 automation:AutomationProperties.AutomationId="Profiles.Schedule.WindowEnd"
                                 automation:AutomationProperties.Name="Window end" />
                        <TextBox Grid.Column="3" Text="{Binding WindowTimezone, Mode=TwoWay}"
                                 PlaceholderText="Timezone"
                                 automation:AutomationProperties.AutomationId="Profiles.Schedule.WindowTimezone"
                                 automation:AutomationProperties.Name="Window timezone" />
                      </Grid>
                      <TextBox Text="{Binding TagsText, Mode=TwoWay}"
                               PlaceholderText="Tags (comma separated)"
                               automation:AutomationProperties.AutomationId="Profiles.Schedule.Tags"
                               automation:AutomationProperties.Name="Schedule tags" />
                      <StackPanel Spacing="6">
                        <TextBlock Text="Metadata" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Metadata}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <!-- ReflectionBinding: the command lives on the nested ScheduleEntry type and the compiled
                                   binding path parser does not accept the Outer+Nested cast form. -->
                              <Grid ColumnDefinitions="*,2*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                                <TextBox Text="{Binding Key, Mode=TwoWay}"
                                         PlaceholderText="Key"
                                         automation:AutomationProperties.AutomationId="Profiles.Schedule.Metadata.Key"
                                         automation:AutomationProperties.Name="Metadata key" />
                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}"
                                         PlaceholderText="Value"
                                         automation:AutomationProperties.AutomationId="Profiles.Schedule.Metadata.Value"
                                         automation:AutomationProperties.Name="Metadata value" />
                                <Button Grid.Column="2" Content="Remove"
                                        Classes="outline"
                                        Command="{ReflectionBinding DataContext.RemoveMetadataCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        automation:AutomationProperties.AutomationId="Profiles.Schedule.Metadata.Remove" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Add metadata"
                                Classes="outline"
                                Command="{Binding AddMetadataCommand}"
                                HorizontalAlignment="Left"
                                automation:AutomationProperties.AutomationId="Profiles.Schedule.AddMetadata" />
                      </StackPanel>
                      <TextBlock Text="{Binding Error}"
                                 Classes="subtitle"
                                 Foreground="{DynamicResource Brush.Accent}"
                                 IsVisible="{Binding Error, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Add schedule"
                    Command="{Binding AddScheduleCommand}"
                    HorizontalAlignment="Left"
                    automation:AutomationProperties.AutomationId="Profiles.AddSchedule" />
          </StackPanel>

          <StackPanel Spacing="10" IsVisible="{Binding HasRunResults}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Text="Run outputs" FontWeight="SemiBold" />
              <Button Content="Open output folder" Classes="outline"
                      Command="{Binding OpenOutputCommand}"
                      automation:AutomationProperties.AutomationId="Profiles.OpenOutput" />
            </StackPanel>
            <Border Classes="surface" Padding="16" CornerRadius="{DynamicResource Radius.Small}">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,*,140,260" Margin="0,0,0,6">
                  <ContentControl Classes="table-header" Content="Source" />
                  <ContentControl Grid.Column="1" Classes="table-header" Content="Destination" />
                  <ContentControl Grid.Column="2" Classes="table-header" Content="Size" />
                  <ContentControl Grid.Column="3" Classes="table-header" Content="SHA-256" />
                </Grid>
                <ItemsControl ItemsSource="{Binding RunResults}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="table-row">
                        <Grid ColumnDefinitions="*,*,140,260">
                          <TextBlock Text="{Binding Source}" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="1" Text="{Binding Destination}" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="2" Text="{Binding Size}" />
                          <TextBlock Grid.Column="3" Text="{Binding Hash}" FontFamily="Consolas" FontSize="12" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      </Grid>
    </Border>
    </Grid>
  </Grid>
</UserControl>
