<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DriftBuster.Gui.ViewModels"
             xmlns:views="using:DriftBuster.Gui.Views"
             xmlns:conv="using:DriftBuster.Gui.Converters"
             xmlns:input="using:Avalonia.Input"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="DriftBuster.Gui.Views.ServerSelectionView"
             x:DataType="vm:ServerSelectionViewModel">
  <UserControl.Resources>
    <Thickness x:Key="ServerSelection.OuterMargin">0,0,0,24</Thickness>
    <x:Double x:Key="ServerSelection.StackSpacing">18</x:Double>
    <x:Double x:Key="ServerSelection.HeaderColumnSpacing">12</x:Double>
    <x:Double x:Key="ServerSelection.SectionSpacing">16</x:Double>
    <Thickness x:Key="ServerSelection.CardPadding">16</Thickness>
    <Thickness x:Key="ServerSelection.CardMargin">0,0,0,16</Thickness>
    <Thickness x:Key="ServerSelection.HighlightPadding">18</Thickness>
  </UserControl.Resources>
  <!-- The view switcher stays at the top; Setup scrolls as a page, the result views fill the rest and scroll their own panes. -->
  <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource ServerSelection.StackSpacing}" Margin="{DynamicResource ServerSelection.OuterMargin}">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
        <ToggleButton x:Name="SetupButton"
                      Content="Setup"
                      Command="{Binding ShowSetupCommand}"
                      IsChecked="{Binding IsViewingSetup, Mode=OneWay}"
                      automation:AutomationProperties.AutomationId="ServerSelection.Setup" />
        <ToggleButton Grid.Column="1"
                      Content="Compare"
                      Command="{Binding ShowCompareCommand}"
                      IsChecked="{Binding IsViewingCompare, Mode=OneWay}"
                      automation:AutomationProperties.AutomationId="ServerSelection.Compare" />
        <ToggleButton Grid.Column="2"
                      Content="Files"
                      Command="{Binding ShowCatalogCommand}"
                      IsChecked="{Binding IsViewingCatalog, Mode=OneWay}"
                      automation:AutomationProperties.AutomationId="ServerSelection.Results" />
        <ToggleButton Grid.Column="3"
                      Content="File details"
                      Command="{Binding ShowDrilldownCommand}"
                      IsChecked="{Binding IsViewingDrilldown, Mode=OneWay}"
                      IsVisible="{Binding DrilldownViewModel, Converter={x:Static ObjectConverters.IsNotNull}}"
                      automation:AutomationProperties.AutomationId="ServerSelection.Drilldown" />
        <Button x:Name="HeaderRunAllButton"
                Grid.Column="4"
                Content="Run all"
                Classes="primary"
                Margin="8,0,0,0"
                Command="{Binding RunAllCommand}"
                IsEnabled="{Binding HasActiveServers}"
                automation:AutomationProperties.AutomationId="ServerSelection.RunAll" />
        <TextBlock Grid.Column="5"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Classes="subtitle"
                   Text="{Binding StatusBanner}" />
      </Grid>

      <!-- Setup fills the space too: the hosts on the left, the selected host's settings on the right, run details below. -->
      <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" RowSpacing="10" IsVisible="{Binding IsViewingSetup}">
        <Border Classes="pane">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ServerSelection.HeaderColumnSpacing}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <ToggleSwitch Content="Remember session" IsChecked="{Binding PersistSessionState}" automation:AutomationProperties.AutomationId="ServerSelection.RememberSession" />
              <Button Content="Save"
                      Classes="outline"
                      Command="{Binding SaveSessionCommand}"
                      IsEnabled="{Binding PersistSessionState}"
                      automation:AutomationProperties.AutomationId="ServerSelection.SaveSession" />
              <Button Content="Add host"
                      Classes="outline"
                      Command="{Binding AddServerCommand}"
                      automation:AutomationProperties.AutomationId="ServerSelection.AddHost" />
              <Button Content="Clear"
                      Classes="outline"
                      Command="{Binding ClearHistoryCommand}"
                      automation:AutomationProperties.AutomationId="ServerSelection.ClearHistory" />
            </StackPanel>
            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                       Text="{Binding CatalogViewModel.Entries.Count, StringFormat='Catalog entries: {0}'}"
                       Classes="subtitle" />
          </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="340,6,*" MinHeight="220">
          <Grid RowDefinitions="*,Auto" RowSpacing="10">
          <!-- Every host: tick to include it in a run, drag to change the order, pick one to edit it. -->
          <Border Classes="pane" Padding="0">
            <ListBox x:Name="HostList"
                     ItemsSource="{Binding Servers}"
                     SelectedItem="{Binding SelectedServer}"
                     Background="Transparent"
                     automation:AutomationProperties.AutomationId="ServerSelection.Hosts"
                     automation:AutomationProperties.Name="Hosts">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ServerSlotViewModel">
                  <Border Background="Transparent"
                          ToolTip.Tip="{Binding ValidationSummary}"
                          automation:AutomationProperties.Name="{Binding ValidationSummary}"
                          PointerPressed="OnServerCardPointerPressed"
                          input:DragDrop.AllowDrop="True"
                          input:DragDrop.DragOver="OnServerCardDragOver"
                          input:DragDrop.Drop="OnServerCardDrop"
                          automation:AutomationProperties.AutomationId="{Binding HostId, StringFormat='ServerSelection.HostCard.{0}'}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                      <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                                ToolTip.Tip="Include this host in runs"
                                automation:AutomationProperties.AutomationId="ServerSelection.HostCard.Enabled"
                                automation:AutomationProperties.Name="{Binding Label, StringFormat='Include {0}'}" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SummaryText}" Classes="subtitle" FontSize="12" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding ShortStatus}" ToolTip.Tip="{Binding StatusText}" Classes="subtitle" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <!-- Registry keys every host reads; each host can add its own and read them from another computer. -->
          <Border Grid.Row="1" Classes="pane">
            <StackPanel Spacing="6">
              <TextBlock Text="Registry keys (all hosts)" FontWeight="SemiBold" />
              <TextBlock Text="Compared like files. A key such as HKLM\SOFTWARE\Vendor, or an app name to find its keys." Classes="subtitle" FontSize="12" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding SharedRegistryKeys}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,0,0,4">
                      <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" />
                      <Button Grid.Column="1" Content="✕" Classes="outline"
                              Command="{Binding ((vm:ServerSelectionViewModel)DataContext).RemoveSharedRegistryKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="Remove this key"
                              automation:AutomationProperties.AutomationId="ServerSelection.SharedRegistry.Remove"
                              automation:AutomationProperties.Name="{Binding StringFormat='Remove {0}'}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Text="{Binding NewSharedRegistryKey, Mode=TwoWay}"
                         PlaceholderText="HKLM\SOFTWARE\Vendor or an app name"
                         automation:AutomationProperties.AutomationId="ServerSelection.SharedRegistry.New"
                         automation:AutomationProperties.Name="New registry key for all hosts" />
                <Button Grid.Column="1" Content="Add" Classes="outline"
                        Command="{Binding AddSharedRegistryKeyCommand}"
                        automation:AutomationProperties.AutomationId="ServerSelection.SharedRegistry.Add" />
              </Grid>
            </StackPanel>
          </Border>
          </Grid>
          <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

          <!-- The selected host's settings. -->
          <Border Grid.Column="2" Classes="pane" IsVisible="{Binding HasSelectedServer}">
            <ScrollViewer AllowAutoHide="False">
              <StackPanel Spacing="12" Margin="0,0,18,0" DataContext="{Binding SelectedServer}" x:DataType="vm:ServerSlotViewModel">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Classes="subtitle" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LastRunText}" Classes="subtitle" IsVisible="{Binding HasLastRun}" VerticalAlignment="Center" />
                    <Button Content="Retry"
                            Classes="outline"
                            IsVisible="{Binding CanRetry}"
                            Command="{Binding ((vm:ServerSelectionViewModel)DataContext).RunMissingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding HostId}"
                            automation:AutomationProperties.AutomationId="ServerSelection.HostCard.Retry" />
                  </StackPanel>
                </Grid>
                <ToggleSwitch IsChecked="{Binding IsEnabled}" Content="Include in runs" automation:AutomationProperties.AutomationId="ServerSelection.Host.Enabled" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
                  <TextBlock Text="Label" Classes="subtitle" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1"
                           Text="{Binding Label, Mode=TwoWay}"
                           automation:AutomationProperties.AutomationId="ServerSelection.HostCard.Label"
                           automation:AutomationProperties.Name="Host label" />
                  <TextBlock Grid.Row="1" Text="Scope" Classes="subtitle" VerticalAlignment="Center" />
                  <ComboBox Grid.Row="1" Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding ((vm:ServerSelectionViewModel)DataContext).ScopeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            SelectedValue="{Binding Scope, Mode=TwoWay}"
                            SelectedValueBinding="{Binding Value}"
                            automation:AutomationProperties.AutomationId="ServerSelection.HostCard.Scope"
                            automation:AutomationProperties.Name="Scan scope">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
                <TextBlock Text="Roots" Classes="subtitle" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Roots}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                        <TextBox Text="{Binding Path, Mode=TwoWay}" automation:AutomationProperties.AutomationId="ServerSelection.HostCard.Root" automation:AutomationProperties.Name="Root path" />
                        <Button Grid.Column="1"
                                Content="✕"
                                Classes="outline"
                                Command="{Binding ((vm:ServerSelectionViewModel)DataContext).RemoveRootCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Remove this root"
                                automation:AutomationProperties.AutomationId="ServerSelection.HostCard.RemoveRoot"
                                automation:AutomationProperties.Name="Remove root" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding NewRootPath, Mode=TwoWay}"
                           PlaceholderText="Add a folder, e.g. C:\inetpub or \\server\C$\apps"
                           automation:AutomationProperties.AutomationId="ServerSelection.HostCard.NewRoot"
                           automation:AutomationProperties.Name="New root path" />
                  <Button Grid.Column="1"
                          Content="Add"
                          Classes="outline"
                          Command="{Binding ((vm:ServerSelectionViewModel)DataContext).AddRootCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}"
                          automation:AutomationProperties.AutomationId="ServerSelection.HostCard.AddRoot" />
                </Grid>
                <TextBlock Text="{Binding RootInputError}" Classes="subtitle" Foreground="{DynamicResource Brush.Accent}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ValidationSummary}" Classes="subtitle" TextWrapping="Wrap" />

                <TextBlock Text="Registry" Classes="subtitle" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
                  <TextBlock Text="Computer" Classes="subtitle" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1"
                           Text="{Binding Computer, Mode=TwoWay}"
                           PlaceholderText="This computer. Or a name, read over WinRM"
                           automation:AutomationProperties.AutomationId="ServerSelection.HostCard.Computer"
                           automation:AutomationProperties.Name="Computer the registry is read from" />
                  <TextBlock Grid.Row="1" Text="Sign-in" Classes="subtitle" VerticalAlignment="Center" IsVisible="{Binding IsRemote}" />
                  <WrapPanel Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsRemote}">
                    <TextBlock Text="{Binding CredentialText}" VerticalAlignment="Center" Margin="0,0,10,6" TextWrapping="Wrap" ToolTip.Tip="{Binding CredentialFile}" />
                    <Button Content="Save sign-in…" Classes="outline" Margin="0,0,6,6" Click="OnSaveCredential"
                            automation:AutomationProperties.AutomationId="ServerSelection.HostCard.SaveCredential" />
                    <Button Content="Use a saved file…" Classes="outline" Margin="0,0,6,6" Click="OnBrowseCredential"
                            automation:AutomationProperties.AutomationId="ServerSelection.HostCard.BrowseCredential" />
                    <Button Content="Use my sign-in" Classes="outline" Margin="0,0,6,6" Click="OnClearCredential" IsVisible="{Binding HasCredentialFile}"
                            automation:AutomationProperties.AutomationId="ServerSelection.HostCard.ClearCredential" />
                  </WrapPanel>
                </Grid>
                <TextBlock Text="Extra keys for this host (besides the keys every host reads)" Classes="subtitle" FontSize="12" />
                <ItemsControl ItemsSource="{Binding RegistryKeys}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" />
                        <Button Grid.Column="1" Content="✕" Classes="outline"
                                Command="{Binding ((vm:ServerSelectionViewModel)DataContext).RemoveRegistryKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Remove this key"
                                automation:AutomationProperties.AutomationId="ServerSelection.HostCard.RemoveRegistryKey"
                                automation:AutomationProperties.Name="{Binding StringFormat='Remove {0}'}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding NewRegistryKey, Mode=TwoWay}"
                           PlaceholderText="HKLM\SOFTWARE\Vendor or an app name"
                           automation:AutomationProperties.AutomationId="ServerSelection.HostCard.NewRegistryKey"
                           automation:AutomationProperties.Name="New registry key for this host" />
                  <Button Grid.Column="1" Content="Add" Classes="outline"
                          Command="{Binding ((vm:ServerSelectionViewModel)DataContext).AddRegistryKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}"
                          automation:AutomationProperties.AutomationId="ServerSelection.HostCard.AddRegistryKey" />
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>

        <!-- Per-host run state and the activity log: useful when something goes wrong, so kept out of the way. -->
        <Grid Grid.Row="2">
          <Expander Header="Run status and activity"
                    HorizontalAlignment="Stretch"
                    automation:AutomationProperties.AutomationId="ServerSelection.RunDetails"
                    automation:AutomationProperties.Name="Run status and activity">
            <ScrollViewer MaxHeight="300" AllowAutoHide="False">
            <Grid ColumnDefinitions="2*,3*" ColumnSpacing="16" Margin="0,0,18,0">
              <Border Classes="surface" Padding="18" CornerRadius="{DynamicResource Radius.Large}">
                <StackPanel Spacing="10">
                  <TextBlock Text="Execution" FontSize="18" FontWeight="SemiBold" />
                  <WrapPanel>
                    <Button Content="Run all" Classes="primary" Command="{Binding RunAllCommand}" IsEnabled="{Binding HasActiveServers}" Margin="0,0,10,10" automation:AutomationProperties.AutomationId="ServerSelection.Execution.RunAll" />
                    <Button Content="Run missing" Classes="outline" Command="{Binding RunMissingCommand}" Margin="0,0,10,10" automation:AutomationProperties.AutomationId="ServerSelection.Execution.RunMissing" />
                    <Button Content="Cancel" Classes="outline" Command="{Binding CancelRunsCommand}" IsEnabled="{Binding IsBusy}" Margin="0,0,10,10" automation:AutomationProperties.AutomationId="ServerSelection.Execution.Cancel" />
                  </WrapPanel>
                  <ItemsControl ItemsSource="{Binding Servers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="2*,*,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Label}" />
                          <TextBlock Text="{Binding RunState}" />
                          <TextBlock Text="{Binding StatusText}" />
                          <Button Grid.Column="3"
                                  Content="File details"
                                  Classes="outline"
                                  Command="{Binding ((vm:ServerSelectionViewModel)DataContext).ShowDrilldownForHostCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding HostId}"
                                  ToolTip.Tip="Open the most recent drilldown for this host."
                                  automation:AutomationProperties.Name="{Binding Label, StringFormat='File details for {0}'}"
                                  automation:AutomationProperties.AutomationId="ServerSelection.Execution.ViewDrilldown" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Classes="surface" Padding="18" CornerRadius="{DynamicResource Radius.Large}">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="Activity timeline" FontSize="18" FontWeight="SemiBold" />
                    <ComboBox Grid.Column="1"
                              Width="160"
                              ItemsSource="{Binding ActivityFilterOptions}"
                              SelectedItem="{Binding ActivityFilter}"
                              automation:AutomationProperties.AutomationId="ServerSelection.ActivityFilter"
                              automation:AutomationProperties.Name="Activity filter" />
                  </Grid>
                  <TextBlock Text="No activity recorded yet."
                             Classes="subtitle"
                             HorizontalAlignment="Center"
                             IsVisible="{Binding HasActivityEntries, Converter={x:Static conv:BooleanNegationConverter.Instance}}" />
                  <ItemsControl x:Name="ActivityVirtualRepeater"
                                 ItemsSource="{Binding FilteredActivityEntries}"
                                 IsVisible="{Binding UseVirtualizedActivityFeed}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Padding="12" Margin="0,0,0,10" CornerRadius="{DynamicResource Radius.Medium}" Classes="surface">
                          <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                              <TextBlock Text="{Binding TimestampText}" Classes="subtitle" />
                              <TextBlock Grid.Column="1" Text="{Binding SeverityLabel}" Classes="subtitle" />
                            </Grid>
                            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                       IsVisible="{Binding Detail, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
                            <Button Content="Copy entry"
                                    HorizontalAlignment="Right"
                                    Classes="outline"
                                    Command="{Binding ((vm:ServerSelectionViewModel)DataContext).CopyActivityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    automation:AutomationProperties.AutomationId="ServerSelection.Activity.Copy" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl x:Name="ActivityFallback"
                                ItemsSource="{Binding FilteredActivityEntries}"
                                IsVisible="{Binding UseVirtualizedActivityFeed, Converter={x:Static conv:BooleanNegationConverter.Instance}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Padding="12" Margin="0,0,0,10" CornerRadius="{DynamicResource Radius.Medium}" Classes="surface">
                          <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                              <TextBlock Text="{Binding TimestampText}" Classes="subtitle" />
                              <TextBlock Grid.Column="1" Text="{Binding SeverityLabel}" Classes="subtitle" />
                            </Grid>
                            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                       IsVisible="{Binding Detail, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
                            <Button Content="Copy entry"
                                    HorizontalAlignment="Right"
                                    Classes="outline"
                                    Command="{Binding ((vm:ServerSelectionViewModel)DataContext).CopyActivityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    automation:AutomationProperties.AutomationId="ServerSelection.Activity.Copy" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Grid>
            </ScrollViewer>
          </Expander>
        </Grid>
      </Grid>

      <Border Grid.Row="1" IsVisible="{Binding IsViewingCompare}">
        <views:CompareView DataContext="{Binding CompareViewModel}" />
      </Border>

      <ContentControl Grid.Row="1"
                      Content="{Binding CatalogViewModel}"
                      IsVisible="{Binding IsViewingCatalog}">
        <ContentControl.ContentTemplate>
          <DataTemplate>
            <views:ResultsCatalogView DataContext="{Binding}" />
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>

      <ContentControl Grid.Row="1"
                      Content="{Binding DrilldownViewModel}"
                      IsVisible="{Binding IsViewingDrilldown}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:ConfigDrilldownViewModel">
            <views:ConfigDrilldownView DataContext="{Binding}" />
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
  </Grid>
</UserControl>
