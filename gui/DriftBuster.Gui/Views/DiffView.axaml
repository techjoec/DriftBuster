<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="using:Avalonia.Automation"
             xmlns:conv="using:DriftBuster.Gui.Converters"
             xmlns:vm="using:DriftBuster.Gui.ViewModels"
             xmlns:views="using:DriftBuster.Gui.Views"
             x:Class="DriftBuster.Gui.Views.DiffView"
             x:DataType="vm:DiffViewModel">
  <!-- Fills the space it is given: the inputs fold away after a build and the results take the rest, one tab at a time. -->
  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
    <StackPanel Spacing="2">
      <TextBlock Classes="heading" Text="Diff planner" />
      <TextBlock Classes="subtitle" Text="Pick a baseline file and the files to compare with it." />
    </StackPanel>

    <Expander Grid.Row="1"
              HorizontalAlignment="Stretch"
              IsExpanded="{Binding InputsExpanded}"
              automation:AutomationProperties.AutomationId="DiffPlanner.Inputs"
              automation:AutomationProperties.Name="Files to compare">
      <Expander.Header>
        <TextBlock Text="{Binding InputsHeader}" FontWeight="SemiBold" />
      </Expander.Header>
      <ScrollViewer MaxHeight="420" AllowAutoHide="False">
        <StackPanel Spacing="12" Margin="0,0,18,0">
            <StackPanel Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center"
                        IsVisible="{Binding HasMruEntries}">
              <TextBlock Text="Recent plans"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <ComboBox MinWidth="360"
                        ItemsSource="{Binding MruEntries}"
                        SelectedItem="{Binding SelectedMruEntry, Mode=TwoWay}"
                        PlaceholderText="Select a previous diff"
                        automation:AutomationProperties.AutomationId="DiffPlanner.MruSelector"
                        automation:AutomationProperties.Name="Recent diff planner entries">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:DiffViewModel+DiffPlannerMruEntryView">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding DisplayName}" />
                      <TextBlock Text="{Binding PayloadKind}"
                                 Classes="subtitle" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Inputs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="surface" Padding="16" Margin="0,0,0,12" CornerRadius="{DynamicResource Radius.Medium}">
                    <StackPanel Spacing="8">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <RadioButton Content="Baseline"
                                     IsChecked="{Binding IsBaseline, Mode=TwoWay}"
                                     GroupName="BaselineGroup"
                                     automation:AutomationProperties.AutomationId="DiffPlanner.Input.Baseline" />
                        <TextBlock Text="Active baseline"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   IsVisible="{Binding IsBaseline}" />
                      </StackPanel>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox PlaceholderText="Select snapshot"
                                 Text="{Binding Path, Mode=TwoWay}"
                                 automation:AutomationProperties.AutomationId="DiffPlanner.Input.Path"
                                 automation:AutomationProperties.Name="Snapshot path" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                          <Button Content="Browse" Classes="outline"
                                  Tag="{Binding}"
                                  Click="OnBrowseFile"
                                  automation:AutomationProperties.AutomationId="DiffPlanner.Input.Browse" />
                          <Button Content="Remove" Classes="outline"
                                  Command="{Binding ((vm:DiffViewModel)DataContext).RemoveVersionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"
                                  automation:AutomationProperties.AutomationId="DiffPlanner.Input.Remove" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Text="{Binding Error}"
                                 Foreground="{DynamicResource Brush.Accent}"
                                 FontSize="12"
                                 IsVisible="{Binding Error, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Add version" Classes="outline"
                    HorizontalAlignment="Left"
                    Command="{Binding AddVersionCommand}"
                    automation:AutomationProperties.AutomationId="DiffPlanner.AddVersion" />
        </StackPanel>
      </ScrollViewer>
    </Expander>

    <StackPanel Grid.Row="2" Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <Button Content="Build plan" Classes="primary"
                Command="{Binding RunDiffCommand}"
                automation:AutomationProperties.AutomationId="DiffPlanner.BuildPlan" />
        <ProgressBar Width="160"
                     IsVisible="{Binding IsBusy}"
                     IsIndeterminate="True"
                     automation:AutomationProperties.AutomationId="DiffPlanner.Progress"
                     automation:AutomationProperties.Name="Building plan" />
        <TextBlock Text="Select files and build the plan to compare them."
                   Classes="subtitle"
                   VerticalAlignment="Center"
                   IsVisible="{Binding ShouldShowPlanHint}" />
      </StackPanel>
      <Border Classes="notice"
                  IsVisible="{Binding HasError}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="⚠"
                         FontSize="16"
                         VerticalAlignment="Center" />
              <TextBlock Text="{Binding ErrorMessage}" FontSize="13" />
            </StackPanel>
          </Border>
    </StackPanel>

    <TabControl Grid.Row="3"
                IsVisible="{Binding HasResult}"
                SelectedIndex="{Binding ResultTab}"
                automation:AutomationProperties.AutomationId="DiffPlanner.Results"
                automation:AutomationProperties.Name="Results">
      <TabItem Header="Settings" IsVisible="{Binding Settings.HasData}" automation:AutomationProperties.AutomationId="DiffPlanner.Tab.Settings">
        <views:CompareView DataContext="{Binding Settings}" />
      </TabItem>
      <TabItem Header="Line by line" automation:AutomationProperties.AutomationId="DiffPlanner.Tab.Lines">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
          <ComboBox ItemsSource="{Binding Comparisons}"
                    SelectedItem="{Binding SelectedComparison}"
                    IsVisible="{Binding HasMultipleComparisons}"
                    MinWidth="360"
                    automation:AutomationProperties.AutomationId="DiffPlanner.ComparisonPicker"
                    automation:AutomationProperties.Name="Comparison">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DiffViewModel+DiffComparisonView">
                <TextBlock Text="{Binding Title}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding SelectedComparison.Title, FallbackValue=''}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="outline"
                    Content="Copy diff"
                    Tag="{Binding SelectedComparison.UnifiedDiff, FallbackValue=''}"
                    Click="OnCopyDiff"
                    automation:AutomationProperties.AutomationId="DiffPlanner.Comparison.CopyDiff" />
          </Grid>
          <views:DiffLinesView Grid.Row="2" DataContext="{Binding SelectedComparison.Lines, FallbackValue={x:Null}}" />
        </Grid>
      </TabItem>
      <TabItem Header="JSON" IsVisible="{Binding HasAnyJson}" automation:AutomationProperties.AutomationId="DiffPlanner.Tab.Json">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <ItemsControl x:Name="JsonViewToggleList"
                          ItemsSource="{Binding JsonViewOptions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DiffViewModel+JsonViewOption">
                  <ToggleButton Classes="outline"
                                MinWidth="96"
                                Padding="6,4"
                                Tag="{Binding Mode}"
                                Content="{Binding DisplayName}"
                                Command="{Binding ((vm:DiffViewModel)DataContext).SelectJsonViewModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Mode}"
                                automation:AutomationProperties.AutomationId="{Binding Mode}"
                                automation:AutomationProperties.Name="{Binding DisplayName}">
                    <ToggleButton.IsChecked>
                      <MultiBinding Converter="{x:Static conv:DiffJsonViewModeMatchConverter.Instance}">
                        <Binding Path="Mode" />
                        <Binding Path="((vm:DiffViewModel)DataContext).JsonViewMode" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                      </MultiBinding>
                    </ToggleButton.IsChecked>
                  </ToggleButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="outline"
                    Content="Copy JSON"
                    Click="OnCopyActiveJson"
                    IsEnabled="{Binding CanCopyActiveJson}"
                    automation:AutomationProperties.AutomationId="DiffPlanner.CopyJsonButton"
                    automation:AutomationProperties.Name="Copy active diff JSON" />
          </StackPanel>
          <Panel Grid.Row="1">
            <Border x:Name="SanitizedJsonPane"
                    Background="{DynamicResource Brush.SurfaceAlt}"
                    Padding="16"
                    CornerRadius="{DynamicResource Radius.Medium}"
                    IsVisible="{Binding IsSanitizedViewActive}"
                    automation:AutomationProperties.AutomationId="DiffPlanner.JsonPane.Sanitized"
                    automation:AutomationProperties.Name="Sanitized diff JSON">
              <ScrollViewer AllowAutoHide="False">
                <TextBlock Text="{Binding SanitizedJson}"
                           FontFamily="Consolas"
                           TextWrapping="Wrap" />
              </ScrollViewer>
            </Border>

            <Border x:Name="RawJsonPane"
                    Background="{DynamicResource Brush.SurfaceAlt}"
                    Padding="16"
                    CornerRadius="{DynamicResource Radius.Medium}"
                    IsVisible="{Binding IsRawViewActive}"
                    automation:AutomationProperties.AutomationId="DiffPlanner.JsonPane.Raw"
                    automation:AutomationProperties.Name="Raw diff JSON">
              <ScrollViewer AllowAutoHide="False">
                <TextBlock Text="{Binding RawJson}"
                           FontFamily="Consolas"
                           TextWrapping="Wrap" />
              </ScrollViewer>
            </Border>
          </Panel>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
