<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="using:Avalonia.Automation"
             xmlns:vm="using:DriftBuster.Gui.ViewModels"
             xmlns:conv="using:DriftBuster.Gui.Converters"
             x:Class="DriftBuster.Gui.Views.ResultsCatalogView"
             x:DataType="vm:ResultsCatalogViewModel">
    <!-- Fills the space it is given: filters on top, the grid takes the rest and scrolls itself with its headers in view. -->
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
      <Border Classes="surface" Padding="14,10" CornerRadius="{DynamicResource Radius.Large}">
        <Grid ColumnDefinitions="*,*,*,*,2*">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="Drift" Classes="subtitle" />
            <ComboBox ItemsSource="{Binding DriftFilterOptions}" SelectedItem="{Binding SelectedDriftFilter}" automation:AutomationProperties.AutomationId="Catalog.DriftFilter" automation:AutomationProperties.Name="Drift" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4" Margin="12,0,0,0">
            <TextBlock Text="Coverage" Classes="subtitle" />
            <ComboBox ItemsSource="{Binding CoverageFilterOptions}"
                      SelectedValue="{Binding SelectedCoverageFilter}"
                      SelectedValueBinding="{Binding Value}"
                      automation:AutomationProperties.AutomationId="Catalog.CoverageFilter"
                      automation:AutomationProperties.Name="Coverage" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4" Margin="12,0,0,0">
            <TextBlock Text="Severity" Classes="subtitle" />
            <ComboBox ItemsSource="{Binding SeverityFilterOptions}"
                      SelectedValue="{Binding SelectedSeverityFilter}"
                      SelectedValueBinding="{Binding Value}"
                      automation:AutomationProperties.AutomationId="Catalog.SeverityFilter"
                      automation:AutomationProperties.Name="Severity" />
          </StackPanel>
          <StackPanel Grid.Column="3" Spacing="4" Margin="12,0,0,0">
            <TextBlock Text="Format" Classes="subtitle" />
            <ComboBox ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding SelectedFormat}" automation:AutomationProperties.AutomationId="Catalog.FormatFilter" automation:AutomationProperties.Name="Format" />
          </StackPanel>
          <StackPanel Grid.Column="4" Spacing="4" Margin="12,0,0,0">
            <TextBlock Text="Search" Classes="subtitle" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Config name or ID" automation:AutomationProperties.AutomationId="Catalog.Search" automation:AutomationProperties.Name="Search" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Classes="surface" Padding="12,10" CornerRadius="{DynamicResource Radius.Large}">
        <Grid RowDefinitions="Auto,*" RowSpacing="6">
          <TextBlock Classes="subtitle" Text="Every scanned file. Double-click a row, or use its button, for the line-by-line diff." />
          <DataGrid x:Name="CatalogGrid"
                    Grid.Row="1"
                    DoubleTapped="OnCatalogGridDoubleTapped"
                    ItemsSource="{Binding FilteredEntriesView}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    HeadersVisibility="Column"
                    GridLinesVisibility="Horizontal"
                    SelectionMode="Single"
                    Sorting="OnCatalogGridSorting"
                    automation:AutomationProperties.AutomationId="Catalog.Grid"
                    automation:AutomationProperties.Name="Configuration catalog">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Config"
                                      Width="3*"
                                      SortMemberPath="{x:Static vm:CatalogSortColumns.Config}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ConfigCatalogItemViewModel">
                    <!-- Long relative paths drop middle folders, never the file name. -->
                    <TextBlock Text="{Binding DisplayName}"
                               TextTrimming="PathSegmentEllipsis"
                               ToolTip.Tip="{Binding DisplayName}"
                               VerticalAlignment="Center"
                               Margin="12,0" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Drift"
                                  x:DataType="vm:ConfigCatalogItemViewModel"
                                  Binding="{Binding DriftSummary}"
                                  Width="Auto"
                                  SortMemberPath="{x:Static vm:CatalogSortColumns.Drift}" />
              <DataGridTextColumn Header="Coverage"
                                  x:DataType="vm:ConfigCatalogItemViewModel"
                                  Binding="{Binding CoverageText}"
                                  Width="Auto"
                                  SortMemberPath="{x:Static vm:CatalogSortColumns.Coverage}" />
              <DataGridTextColumn Header="Format"
                                  x:DataType="vm:ConfigCatalogItemViewModel"
                                  Binding="{Binding Format}"
                                  Width="Auto"
                                  SortMemberPath="{x:Static vm:CatalogSortColumns.Format}" />
              <DataGridTextColumn Header="Severity"
                                  x:DataType="vm:ConfigCatalogItemViewModel"
                                  Binding="{Binding Severity}"
                                  Width="Auto"
                                  SortMemberPath="{x:Static vm:CatalogSortColumns.Severity}" />
              <DataGridTextColumn Header="Updated"
                                  x:DataType="vm:ConfigCatalogItemViewModel"
                                  Binding="{Binding LastUpdatedText}"
                                  Width="Auto"
                                  SortMemberPath="{x:Static vm:CatalogSortColumns.Updated}" />
              <DataGridTemplateColumn Header="Tags" Width="2*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ConfigCatalogItemViewModel">
                    <WrapPanel>
                      <Border Classes="badge" IsVisible="{Binding HasDrift}">
                        <TextBlock Text="Drift" />
                      </Border>
                      <Border Classes="badge danger" IsVisible="{Binding HasSecrets}">
                        <TextBlock Text="Secrets" />
                      </Border>
                      <Border Classes="badge warn" IsVisible="{Binding HasMaskedTokens}">
                        <TextBlock Text="Masked" />
                      </Border>
                      <Border Classes="badge warn" IsVisible="{Binding HasValidationIssues}">
                        <TextBlock Text="Validation" />
                      </Border>
                    </WrapPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ConfigCatalogItemViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="File details"
                              Classes="outline"
                              Padding="8,2"
                              Command="{Binding ((vm:ResultsCatalogViewModel)DataContext).DrilldownCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                              CommandParameter="{Binding}"
                              automation:AutomationProperties.AutomationId="Catalog.Grid.Drilldown" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <!-- Files some servers lack: collapsed so the grid keeps the room. -->
      <Expander Grid.Row="2"
                HorizontalAlignment="Stretch"
                IsVisible="{Binding HasPartialCoverage}"
                automation:AutomationProperties.AutomationId="Catalog.MissingArtifacts"
                automation:AutomationProperties.Name="Files missing on some servers">
        <Expander.Header>
          <TextBlock Text="{Binding PartialCoverageTitle}" FontWeight="SemiBold" />
        </Expander.Header>
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <TextBlock Text="Re-scan a file's missing servers, or all of them at once." Classes="subtitle" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="Re-scan all missing"
                    Classes="outline"
                    Command="{Binding ReScanAllPartialCommand}"
                    Margin="12,0,0,0"
                    automation:AutomationProperties.AutomationId="Catalog.ReScanAllMissing" />
          </Grid>
          <ScrollViewer MaxHeight="260" AllowAutoHide="False">
          <StackPanel Margin="0,0,18,0">
          <ItemsControl x:Name="PartialCoverageVirtualRepeater"
                         ItemsSource="{Binding PartialCoverageEntries}"
                         IsVisible="{Binding UseVirtualizedPartialCoverage}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="12" CornerRadius="{DynamicResource Radius.Medium}" Classes="surface" Margin="0,0,0,10">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CoverageText}" Classes="subtitle" />
                    <TextBlock Text="{Binding MissingHostsSummary}" Classes="subtitle" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Drilldown"
                              Classes="outline"
                              Command="{Binding ((vm:ResultsCatalogViewModel)DataContext).DrilldownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}"
                              automation:AutomationProperties.AutomationId="Catalog.Partial.Drilldown" />
                      <Button Content="Re-scan missing"
                              Classes="outline"
                              Command="{Binding ((vm:ResultsCatalogViewModel)DataContext).ReScanMissingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}"
                              automation:AutomationProperties.AutomationId="Catalog.Partial.ReScanMissing" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl x:Name="PartialCoverageFallback"
                        ItemsSource="{Binding PartialCoverageEntries}"
                        IsVisible="{Binding UseVirtualizedPartialCoverage, Converter={x:Static conv:BooleanNegationConverter.Instance}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="12" CornerRadius="{DynamicResource Radius.Medium}" Classes="surface" Margin="0,0,0,10">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CoverageText}" Classes="subtitle" />
                    <TextBlock Text="{Binding MissingHostsSummary}" Classes="subtitle" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Drilldown"
                              Classes="outline"
                              Command="{Binding ((vm:ResultsCatalogViewModel)DataContext).DrilldownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}"
                              automation:AutomationProperties.AutomationId="Catalog.Partial.Drilldown" />
                      <Button Content="Re-scan missing"
                              Classes="outline"
                              Command="{Binding ((vm:ResultsCatalogViewModel)DataContext).ReScanMissingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}"
                              automation:AutomationProperties.AutomationId="Catalog.Partial.ReScanMissing" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </StackPanel>
          </ScrollViewer>
        </StackPanel>
      </Expander>
    </Grid>
</UserControl>
