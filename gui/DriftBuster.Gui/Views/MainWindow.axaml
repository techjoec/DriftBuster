<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="using:Avalonia.Automation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DriftBuster.Gui.ViewModels"
        xmlns:conv="using:DriftBuster.Gui.Converters"
        xmlns:anim="using:Avalonia.Animation"
        xmlns:views="using:DriftBuster.Gui.Views"
        x:Class="DriftBuster.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        mc:Ignorable="d"
        Width="1120"
        Height="720"
        Title="DrB DriftBuster">

  <Window.Resources>
    <Thickness x:Key="Layout.HeaderPadding">20,16</Thickness>
    <Thickness x:Key="Layout.ContentMargin">20</Thickness>
    <Thickness x:Key="Layout.SectionCardPadding">16</Thickness>
    <Thickness x:Key="Layout.PrimaryCardPadding">24</Thickness>
    <Thickness x:Key="Layout.SectionSpacing">0,16,0,0</Thickness>
    <x:Double x:Key="Toast.Width">320</x:Double>
    <Thickness x:Key="Toast.Padding">14</Thickness>
    <Thickness x:Key="Toast.CardMargin">0,0,0,8</Thickness>
    <x:Double x:Key="Toast.IconFontSize">20</x:Double>
    <x:Double x:Key="Toast.InnerSpacing">8</x:Double>
    <Thickness x:Key="Toast.HostMargin">0,24,24,0</Thickness>
    <x:Double x:Key="Toast.StackSpacing">8</x:Double>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*">
    <!-- One compact bar: name, tabs, core status, theme. -->
    <Border Padding="{DynamicResource Layout.HeaderPadding}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border}" Background="{DynamicResource Brush.Surface}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource Brush.Accent}">
            <TextBlock Text="DrB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#0B1120" />
          </Border>
          <TextBlock Text="DriftBuster" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <ToggleButton Content="Multi-server"
                        Command="{Binding ShowMultiServerCommand}"
                        IsChecked="{Binding IsMultiServerSelected, Mode=OneWay}"
                        automation:AutomationProperties.AutomationId="Shell.Tab.MultiServer" />
          <ToggleButton Content="Diff planner"
                        Command="{Binding ShowDiffCommand}"
                        IsChecked="{Binding IsDiffSelected, Mode=OneWay}"
                        automation:AutomationProperties.AutomationId="Shell.Tab.DiffPlanner" />
          <ToggleButton Content="Hunt explorer"
                        Command="{Binding ShowHuntCommand}"
                        IsChecked="{Binding IsHuntSelected, Mode=OneWay}"
                        automation:AutomationProperties.AutomationId="Shell.Tab.HuntExplorer" />
          <ToggleButton Content="Profiles"
                        Command="{Binding ShowProfilesCommand}"
                        IsChecked="{Binding IsProfilesSelected, Mode=OneWay}"
                        automation:AutomationProperties.AutomationId="Shell.Tab.Profiles" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="10" Height="10" CornerRadius="5"
                  Background="{Binding IsBackendHealthy, Converter={x:Static conv:BoolToBrushConverter.Instance}, ConverterParameter='#21C55D;#EF4444'}">
            <ToolTip.Tip>
              <TextBlock Text="{Binding BackendStatusText}" />
            </ToolTip.Tip>
          </Border>
          <Button Classes="outline" Content="Check core" Command="{Binding CheckHealthCommand}" automation:AutomationProperties.AutomationId="Shell.CheckCore" />
        </StackPanel>
        <ComboBox x:Name="ThemeSelector"
                  Grid.Column="3"
                  MinWidth="110"
                  VerticalAlignment="Center"
                  ItemsSource="{Binding ThemeOptions}"
                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                  ToolTip.Tip="Theme"
                  automation:AutomationProperties.AutomationId="Shell.Theme"
                  automation:AutomationProperties.Name="Theme">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
          <ComboBox.SelectionBoxItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.SelectionBoxItemTemplate>
        </ComboBox>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Margin="{DynamicResource Layout.ContentMargin}"
            Classes="dashboard-card"
            Padding="{DynamicResource Layout.PrimaryCardPadding}"
            CornerRadius="{DynamicResource Radius.Large}">
      <TransitioningContentControl Content="{Binding CurrentView}">
        <TransitioningContentControl.PageTransition>
          <anim:CrossFade Duration="0:0:0.15" />
        </TransitioningContentControl.PageTransition>
      </TransitioningContentControl>
    </Border>
    <views:ToastHost Grid.RowSpan="2" DataContext="{Binding Toasts}" />
  </Grid>
</Window>
