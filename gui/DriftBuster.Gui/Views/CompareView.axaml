<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DriftBuster.Gui.ViewModels"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="DriftBuster.Gui.Views.CompareView"
             x:DataType="vm:CompareViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="F8" Command="{Binding NextDifferenceCommand}" />
    <KeyBinding Gesture="Shift+F8" Command="{Binding PreviousDifferenceCommand}" />
  </UserControl.KeyBindings>
  <UserControl.Styles>
    <Style Selector="TextBlock.dot">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.dot.ok">
      <Setter Property="Foreground" Value="{DynamicResource Brush.OkText}" />
    </Style>
    <Style Selector="TextBlock.dot.differs">
      <Setter Property="Foreground" Value="{DynamicResource Brush.DiffersText}" />
    </Style>
    <Style Selector="TextBlock.dot.failed">
      <Setter Property="Foreground" Value="{DynamicResource Brush.MissingText}" />
    </Style>
    <Style Selector="TextBlock.file-summary.differs">
      <Setter Property="Foreground" Value="{DynamicResource Brush.DiffersText}" />
    </Style>
    <Style Selector="Grid.ignored, Border.ignored">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="TextBlock.row-flags">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.cell">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Margin" Value="2,1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
    </Style>
    <Style Selector="Border.cell.differs">
      <Setter Property="Background" Value="{DynamicResource Brush.DiffersBackground}" />
    </Style>
    <Style Selector="Border.cell.differs TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.absent">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <Style Selector="Border.cell.differs TextBlock.absent">
      <Setter Property="Foreground" Value="{DynamicResource Brush.MissingText}" />
    </Style>
  </UserControl.Styles>

  <!-- Fills the space it is given: the file list and the settings table scroll on their own, the rest stays put. -->
  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
    <!-- What differs, per server, in one sentence each. -->
    <Border Classes="surface" CornerRadius="{DynamicResource Radius.Large}" Padding="14,10">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Headline}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Servers}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CompareServerViewModel">
              <Button Classes="chip"
                      Classes.selected="{Binding IsFocused}"
                      Command="{Binding ((vm:CompareViewModel)DataContext).FocusServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}"
                      ToolTip.Tip="Show only what differs on this server"
                      automation:AutomationProperties.AutomationId="Compare.Server"
                      automation:AutomationProperties.Name="{Binding Label, StringFormat='Show only what differs on {0}'}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="dot" Classes.ok="{Binding Matches}" Classes.differs="{Binding Differs}" Classes.failed="{Binding Failed}"
                             Text="●" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Filters and export. -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
      <CheckBox Content="Only show differences"
                IsChecked="{Binding DifferencesOnly}"
                VerticalAlignment="Center"
                automation:AutomationProperties.AutomationId="Compare.DifferencesOnly" />
      <TextBox Grid.Column="1"
               Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="Search settings, values or files"
               automation:AutomationProperties.AutomationId="Compare.Search"
               automation:AutomationProperties.Name="Search settings, values or files" />
      <Button Grid.Column="2"
              Content="Show all servers"
              Classes="outline"
              IsVisible="{Binding HasFocus}"
              Command="{Binding ClearFocusCommand}"
              ToolTip.Tip="{Binding FocusText}"
              automation:AutomationProperties.AutomationId="Compare.ClearFocus" />
      <Button Grid.Column="3"
              Content="Save report"
              Classes="outline"
              Command="{Binding SaveReportCommand}"
              ToolTip.Tip="Save this comparison as an HTML report and a CSV file"
              automation:AutomationProperties.AutomationId="Compare.SaveReport" />
    </Grid>

    <StackPanel Grid.Row="2" Spacing="6">
      <!-- Curation filters: marks, ignored things, the review list, and the saved choices. -->
      <WrapPanel>
        <TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,6,6" Classes="subtitle" />
        <ComboBox ItemsSource="{Binding MarkFilters}"
                  SelectedItem="{Binding MarkFilter}"
                  MinWidth="120"
                  Margin="0,0,12,6"
                  ToolTip.Tip="All settings, only marked ones, or only unmarked ones"
                  automation:AutomationProperties.AutomationId="Compare.MarkFilter"
                  automation:AutomationProperties.Name="Marked settings" />
        <CheckBox Content="Show ignored"
                  IsChecked="{Binding ShowIgnored}"
                  Margin="0,0,12,6"
                  ToolTip.Tip="Show ignored files and settings, dimmed"
                  automation:AutomationProperties.AutomationId="Compare.ShowIgnored" />
        <ToggleButton Content="{Binding ReviewToggleText}"
                      IsChecked="{Binding ReviewOnly}"
                      Margin="0,0,6,6"
                      ToolTip.Tip="Show only the settings picked for review"
                      automation:AutomationProperties.AutomationId="Compare.ReviewOnly"
                      automation:AutomationProperties.Name="Review list" />
        <Button Content="Export review"
                Classes="outline"
                Margin="0,0,12,6"
                IsVisible="{Binding ReviewOnly}"
                Command="{Binding ExportReviewCommand}"
                ToolTip.Tip="Save the review list as an HTML report and a CSV file"
                automation:AutomationProperties.AutomationId="Compare.ExportReview" />
        <Button Content="Manage choices…"
                Classes="outline"
                Margin="0,0,6,6"
                Click="OnManageChoices"
                ToolTip.Tip="Groups, rules, ignore and mask choices, history, import and export"
                automation:AutomationProperties.AutomationId="Compare.Manage" />
      </WrapPanel>
      <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasGroupFilter}">
        <TextBlock Text="{Binding GroupFilterText}" VerticalAlignment="Center" FontWeight="SemiBold" />
        <Button Content="Show every setting"
                Classes="outline"
                Command="{Binding ClearGroupFilterCommand}"
                automation:AutomationProperties.AutomationId="Compare.ClearGroup" />
      </StackPanel>
      <TextBlock Text="{Binding FocusText}" IsVisible="{Binding HasFocus}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap" Classes="subtitle" />
      <TextBlock Text="{Binding EmptyMessage}" IsVisible="{Binding HasEmptyMessage}" FontSize="16" TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="3" x:Name="Body" ColumnDefinitions="320,6,*" MinHeight="240">
      <!-- Every file that matches the filters; pick one to see its settings. -->
      <Border x:Name="FileListPane" Classes="surface" CornerRadius="{DynamicResource Radius.Medium}" Padding="0">
        <ListBox ItemsSource="{Binding VisibleFiles}"
                 SelectedItem="{Binding SelectedFile}"
                 Background="Transparent"
                 automation:AutomationProperties.AutomationId="Compare.Files"
                 automation:AutomationProperties.Name="Files">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CompareFileViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" ToolTip.Tip="{Binding Path}"
                    Classes.ignored="{Binding Ignored}"
                    Background="Transparent"
                    ContextRequested="OnFileContextRequested"
                    automation:AutomationProperties.Name="{Binding Path}">
                <TextBlock Classes="dot" Classes.differs="{Binding Differs}" Text="●" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding AppName}" IsVisible="{Binding HasAppName}" Classes="subtitle" FontSize="12" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Folder}" IsVisible="{Binding HasFolder}" Classes="subtitle" FontSize="12"
                             TextTrimming="PathSegmentEllipsis" />
                </StackPanel>
                <Border Grid.Column="2" Classes="count" IsVisible="{Binding HasBadge}">
                  <TextBlock Text="{Binding Badge}" FontSize="12" FontWeight="SemiBold" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <GridSplitter x:Name="FileListSplitter" Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

      <!-- The selected file: what differs in words, then its settings with the headers and setting names kept in view. -->
      <Border Grid.Column="2" Classes="surface" CornerRadius="{DynamicResource Radius.Medium}" Padding="12,10"
              IsVisible="{Binding HasSelectedFile}">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding SelectedFile.FileName, FallbackValue=''}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SelectedFile.AppName, FallbackValue=''}" IsVisible="{Binding SelectedFile.HasAppName, FallbackValue=False}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SelectedFile.Description, FallbackValue=''}" IsVisible="{Binding SelectedFile.HasDescription, FallbackValue=False}" Classes="subtitle" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SelectedFile.Folder, FallbackValue=''}" IsVisible="{Binding SelectedFile.HasFolder, FallbackValue=False}"
                         Classes="subtitle" TextWrapping="Wrap" />
              <TextBlock Classes="file-summary" Classes.differs="{Binding SelectedFile.Differs, FallbackValue=False}"
                         Text="{Binding SelectedFile.Summary, FallbackValue=''}" TextWrapping="Wrap" />
              <TextBlock Classes="subtitle" TextWrapping="Wrap">
                <Run Text="{Binding SelectedFile.RowCountText, FallbackValue=''}" />
                <Run Text="  " />
                <Run Text="{Binding PositionText}" />
              </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
              <Button Content="◀ Previous"
                      Classes="outline"
                      Command="{Binding PreviousDifferenceCommand}"
                      ToolTip.Tip="Previous difference (Shift+F8)"
                      automation:AutomationProperties.AutomationId="Compare.PreviousDifference"
                      automation:AutomationProperties.Name="Previous difference" />
              <Button Content="Next ▶"
                      Classes="outline"
                      Command="{Binding NextDifferenceCommand}"
                      ToolTip.Tip="Next difference (F8)"
                      automation:AutomationProperties.AutomationId="Compare.NextDifference"
                      automation:AutomationProperties.Name="Next difference" />
              <Button Content="File details"
                      Classes="outline"
                      IsVisible="{Binding SelectedFile.HasDetails, FallbackValue=False}"
                      Command="{Binding OpenDetailsCommand}"
                      CommandParameter="{Binding SelectedFile}"
                      ToolTip.Tip="Line-by-line diff and exports for this file"
                      automation:AutomationProperties.AutomationId="Compare.FileDetails"
                      automation:AutomationProperties.Name="File details" />
            </StackPanel>
          </Grid>

          <DataGrid x:Name="SettingsGrid"
                    Grid.Row="1"
                    ItemsSource="{Binding SelectedFile.VisibleRows, FallbackValue={x:Null}}"
                    SelectedItem="{Binding SelectedRow}"
                    IsVisible="{Binding SelectedFile.HasVisibleRows, FallbackValue=False}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    SelectionMode="Single"
                    HeadersVisibility="Column"
                    GridLinesVisibility="Horizontal"
                    FrozenColumnCount="1"
                    CanUserSortColumns="False"
                    CanUserReorderColumns="False"
                    automation:AutomationProperties.AutomationId="Compare.Settings"
                    automation:AutomationProperties.Name="Settings" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
